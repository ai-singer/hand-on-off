{
  "manifest_version": "1.0.0",
  "plugin": {
    "name": "xiaolin_finance",
    "version": "1.2.0",
    "domain": "finance",
    "creator_target": "xiaolin-style-finance-explainer"
  },
  "contract": {
    "specification": "creator-distillation-plugin",
    "version": "1.0"
  },
  "entrypoint": {
