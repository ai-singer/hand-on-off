          "source_asset": {
            "type": "string"
          },
          "asset_type": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "declared",
              "unavailable"
            ]
          },
          "available": {
            "type": "boolean"
          },
          "values_source": {
            "type": "string",
            "enum": [
              "asset",
              "catalog"
            ]
          },
          "deliverable": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "source_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
