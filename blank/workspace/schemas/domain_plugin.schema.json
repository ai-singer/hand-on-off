            ]
          },
          "source_asset": {
            "type": "string"
          },
          "asset_type": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "declared",
              "unavailable"
            ]
          },
          "available": {
            "type": "boolean"
          },
          "values_source": {
            "type": "string",
            "enum": [
